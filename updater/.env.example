# Provider selection (only openai is implemented)
AI_PROVIDER=openai

# OpenAI credentials and model (Responses API + web_search)
# Never commit real secrets. Copy this file to .env and fill in locally.
OPENAI_API_KEY=
# Model must support Responses API tools including web_search.
# See https://platform.openai.com/docs/guides/tools-web-search
OPENAI_MODEL=gpt-4o

# Research run defaults
RESEARCH_MAX_NEW_ROWS=40
# Request timeout in seconds (SDK / HTTP). Empty uses the SDK default.
RESEARCH_TIMEOUT_SECONDS=600
# Upper bound on generated tokens (visible + reasoning). Empty uses the API default.
RESEARCH_MAX_OUTPUT_TOKENS=16000

# Reserved for a future provider (not implemented; credentials not required)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
